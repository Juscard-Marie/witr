<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>For Tamara 💖</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap');

* { box-sizing: border-box; }

body {
  margin: 0;
  height: 100vh;
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(135deg, #fbc2eb, #a6c1ee);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

/* Card */
.card {
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(16px);
  border-radius: 28px;
  padding: 32px;
  max-width: 440px;
  text-align: center;
  box-shadow: 0 30px 70px rgba(0,0,0,0.3);
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-12px); }
}

/* Name animation */
.name span {
  opacity: 0;
  animation: show 0.5s forwards;
}

@keyframes show {
  to { opacity: 1; }
}

h1 { font-size: 30px; margin-bottom: 10px; }

.sub { font-size: 16px; margin-bottom: 25px; }

/* Buttons */
.btn {
  background: #fff;
  color: #a84d8f;
  border: none;
  border-radius: 50px;
  padding: 14px 26px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 10px 20px rgba(0,0,0,0.25);
  transition: transform 0.2s ease;
  margin-top: 10px;
}

.btn:hover { transform: scale(1.05); }

/* Messages */
.message {
  display: none;
  margin-top: 25px;
  font-size: 16px;
  line-height: 1.7;
  animation: fade 1.2s ease forwards;
}

@keyframes fade {
  from { opacity: 0; transform: translateY(18px); }
  to { opacity: 1; transform: translateY(0); }
}

.signature {
  margin-top: 18px;
  font-weight: 600;
  font-size: 15px;
}

/* Hearts */
.heart {
  position: fixed;
  top: -10px;
  font-size: 20px;
  animation: fall linear infinite;
}

@keyframes fall {
  0% { transform: translateY(-10px); }
  100% { transform: translateY(110vh); }
}

/* Confetti */
.confetti {
  position: fixed;
  width: 8px;
  height: 8px;
  animation: confetti 4s linear infinite;
}

@keyframes confetti {
  0% { transform: translateY(-10px) rotate(0deg); }
  100% { transform: translateY(110vh) rotate(360deg); }
}

/* Fireworks */
.firework {
  position: fixed;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  animation: explode 1.5s ease-out forwards;
}

@keyframes explode {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(20); opacity: 0; }
}
</style>
</head>

<body>

<!-- Calm Romantic Music -->
<audio id="music" loop>
  <source src="https://cdn.pixabay.com/audio/2022/05/23/audio_7bdb60e9b0.mp3" type="audio/mpeg">
</audio>

<div class="card">
  <h1 class="name" id="name"></h1>
  <div class="sub">A gentle appreciation gift just for you 🌸</div>

  <button class="btn" onclick="firstReveal()">Tap to Reveal 💖</button>
  <button class="btn" id="secondBtn" style="display:none" onclick="secondReveal()">Tap Again ✨</button>
  <button class="btn" id="finalBtn" style="display:none" onclick="finalReveal()">Final Message 🎆</button>

  <div class="message" id="msg1">
    <p>
      This year truly carried your name, Tamara 🌷  
      You moved through it with warmth, kindness, and positive energy.
    </p>
    <p>
      Without even trying, you made moments lighter and happier 😊
    </p>
  </div>

  <div class="message" id="msg2">
    <p>
      Just in case no one reminded you enough —
      you are deeply appreciated 💫
    </p>
    <p>
      Your presence alone made this year feel meaningful to someone.
    </p>
  </div>

  <div class="message" id="msg3">
    <p>
      Thank you for being you 🌼  
      Thank you for the smiles, the calm moments,
      and the happiness you brought without effort.
    </p>
    <p>
      This is simply a small reminder of how much that mattered 💖
    </p>
    <p class="signature">
      — From <b>JUSCARD MARIE</b> 🤍
    </p>
  </div>
</div>

<script>
/* Name animation */
const nameText = "Tamara 💕";
const nameEl = document.getElementById("name");
[...nameText].forEach((char, i) => {
  const span = document.createElement("span");
  span.textContent = char;
  span.style.animationDelay = `${i * 0.15}s`;
  nameEl.appendChild(span);
});

/* Reveal flow */
function firstReveal() {
  document.getElementById("msg1").style.display = "block";
  document.getElementById("secondBtn").style.display = "inline-block";
  document.getElementById("music").play();
}

function secondReveal() {
  document.getElementById("msg2").style.display = "block";
  document.getElementById("finalBtn").style.display = "inline-block";
}

function finalReveal() {
  document.getElementById("msg3").style.display = "block";
  launchFireworks();
}

/* Hearts */
setInterval(() => {
  const h = document.createElement("div");
  h.className = "heart";
  h.innerHTML = "💖";
  h.style.left = Math.random() * 100 + "vw";
  h.style.animationDuration = (3 + Math.random() * 4) + "s";
  document.body.appendChild(h);
  setTimeout(() => h.remove(), 7000);
}, 350);

/* Confetti */
setInterval(() => {
  const c = document.createElement("div");
  c.className = "confetti";
  c.style.left = Math.random() * 100 + "vw";
  c.style.background = ["#ffb6c1","#ffd1dc","#fff0f5"][Math.floor(Math.random()*3)];
  document.body.appendChild(c);
  setTimeout(() => c.remove(), 4000);
}, 300);

/* Fireworks */
function launchFireworks() {
  for (let i = 0; i < 25; i++) {
    const f = document.createElement("div");
    f.className = "firework";
    f.style.left = Math.random() * 100 + "vw";
    f.style.top = Math.random() * 60 + "vh";
    f.style.background = ["#ff69b4","#ffd700","#ffffff"][Math.floor(Math.random()*3)];
    document.body.appendChild(f);
    setTimeout(() => f.remove(), 1500);
  }
}
</script>

</body>
</html>
